# Node >=24; copy to .env on the deployment host. Never commit .env.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
CONFESSIONAL_CHANNEL_ID=
NUN_USER_IDS=
NUN_ROLE_IDS=
# Generate on the host: openssl rand -hex 32
SESSION_SECRET=
DATABASE_URL=sqlite:data/confessional.sqlite
PUBLIC_ORIGIN=https://confessional.example.com
# Optional comma-separated additional trusted frontend origins (local dev only as needed)
ALLOWED_ORIGINS=
API_ORIGIN=
WEBSOCKET_ORIGIN=
PORT=3001
ADULT_MODE=false
ALLOW_PUBLIC_STICKER_SHARE=false

AI_NUN_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
